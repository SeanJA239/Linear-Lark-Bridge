            "type": "boolean"
          },
          "user": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MeUser"
              }
            ]
          }
        }
      },
      "MeUser": {
        "type": "object",
        "required": [
          "email",
          "name"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "OkResponse": {
        "type": "object",
        "description": "Generic `{ \"ok\": true }` success body.",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      },
      "StatusResponse": {
        "type": "object",
        "description": "Body of `GET /api/status`.",
        "required": [
          "subsystems"
        ],
        "properties": {
          "subsystems": {
            "type": "object",
            "description": "Subsystem name → its latest status.",
            "additionalProperties": {
              "$ref": "#/components/schemas/SubsystemStatus"
            },
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "SubsystemState": {
        "type": "string",
        "description": "Wire mirror of `larkstack_core::State`.",
        "enum": [
          "starting",
          "running",
          "errored",
          "stopped"
        ]
      },
      "SubsystemStatus": {
        "type": "object",
        "description": "One subsystem's status — wire mirror of `larkstack_core::Status`.",
        "required": [
          "state",
          "updated_at"
        ],
        "properties": {
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "$ref": "#/components/schemas/SubsystemState"
          },
          "updated_at": {
            "type": "integer",
            "format": "int64",
            "description": "Unix-epoch milliseconds of the last transition.",
            "minimum": 0
          }
        }
      },
      "TestReq": {
        "type": "object",
        "required": [
          "app_id",
          "app_secret"
        ],
        "properties": {
          "app_id": {
            "type": "string"
          },
          "app_secret": {
            "type": "string"
          },
          "base_url": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "TestResult": {
        "type": "object",
        "description": "Body of `POST /api/lark-apps/test`: `ok` plus either the token lifetime or\nthe failure reason.",
        "required": [
          "ok"
        ],
        "properties": {
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Failure reason, on error."
          },
          "expire": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Token lifetime in seconds, on success.",
            "minimum": 0
          },
          "ok": {
            "type": "boolean"
          }
        }
      },
      "UpsertAck": {
        "type": "object",
        "description": "Body of a successful `POST /api/lark-apps`.",
        "required": [
          "ok",
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          }
        }
      },
      "UpsertReq": {
        "type": "object",
        "required": [
          "name",
          "app_id",
          "app_secret"
        ],
        "properties": {
          "app_id": {
            "type": "string"
          },
          "app_secret": {
            "type": "string"
          },
          "base_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "lk_session"
      }
    }
  },
  "tags": [
    {
      "name": "console",
